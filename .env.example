

# Base de datos en Amazon RDS (PostgreSQL). El endpoint aparece en RDS -> tu base -> "Conectividad y seguridad".
DB_URL=jdbc:postgresql://ENDPOINT_DEL_RDS:5432/sonido_vivo
DB_USER=postgres
DB_PASSWORD=clave-maestra-del-rds

# Genera una clave aleatoria con:  openssl rand -base64 48
JWT_SECRET=pega-aqui-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60

# URL del frontend (Vite usa 5173 por defecto). Agregar la URL pública si lo despliegan.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Contraseña de las cuentas de demostración (admin, vendedor, cliente). Solo datos ficticios.
DEMO_PASSWORD=Demo2026!
